# ─────────────────────────────────────────────────────────────────────────────
# Template for Streamlit Cloud → App settings → Secrets  (or local .streamlit/secrets.toml)
# Never commit the real file. See DEPLOY.md for where each value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# Who manages the app (always allowed in, sees the admin panel, may use GEMINI_API_KEY below)
ADMIN_EMAILS = ["you@gmail.com"]

# Optional fixed allow-list. You can also add/remove people from inside the app (Settings → Admin).
# Supports whole domains: "*@company.com"
ALLOWED_EMAILS = []

# Long random string — encrypts users' saved Gemini keys. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_SECRET = "change-me"

# Free Postgres (Neon / Supabase) so watchlists & history survive restarts
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Your own Gemini key — used only by ADMIN_EMAILS (other users bring their own free key)
GEMINI_API_KEY = ""

# Optional
FINNHUB_API_KEY = ""
SEC_USER_AGENT = "StockAnalyzer you@gmail.com"

[auth]
redirect_uri = "https://YOUR-APP-NAME.streamlit.app/oauth2callback"
cookie_secret = "another-long-random-string"
client_id = "XXXXXXXX.apps.googleusercontent.com"
client_secret = "XXXXXXXX"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
